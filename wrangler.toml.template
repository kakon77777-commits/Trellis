name = "evemisslab-trellis"
main = "cloudflare/worker.mjs"
compatibility_date = "2026-09-08"
compatibility_flags = ["nodejs_compat"]

[[d1_databases]]
binding = "DB"
database_name = "evemisslab-trellis"
database_id = "__TRELLIS_D1_DATABASE_ID__"
migrations_dir = "db/migrations"

[assets]
directory = "web/public"
binding = "ASSETS"
run_worker_first = ["/assets/*"]
